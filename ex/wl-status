#!/usr/bin/env bash

font="JetBrains Mono 14"

# Create a FIFO pipe so we can write status lines to figbar while reading click events from its stdout
pipe=$(mktemp -u)
mkfifo "$pipe"
trap 'rm -f "$pipe"' EXIT

# Background process: periodically writes status with [[key]] tags to the FIFO
(
	while true; do
		workspaces="[[ws_1]] 1 ^[[ws_2]] 2 ^[[ws_3]] 3 [[ws_4]] 4 [[ws_5]] 5 "
		bat=$(cat /sys/class/power_supply/BAT0/capacity 2>/dev/null || echo "100")
		timestamp=$(date +%R)
		margin="$(printf "%*s" $((131 - ${#timestamp} - ${#bat})))"
		echo "${workspaces}^[[msg]] figbar is running ${margin} ^[[bat]] BAT ${bat} | [[time]]${timestamp}"
		sleep 5
	done
) > "$pipe" &
PRODUCER_PID=$!
trap 'kill "$PRODUCER_PID" 2>/dev/null; rm -f "$pipe"' EXIT

# Run figbar reading from FIFO and process JSONL click events from its stdout
figbar -f "$font" < "$pipe" | while read -r event; do
	# Example event: {"event":"click","key":"bat","index":3,"button":1}
	echo "Received click event: $event"
done
